# Copiez ce fichier en ".env" (à la racine de MNBot) et remplissez les valeurs utiles.
# Ce fichier .env n'est JAMAIS envoyé sur GitHub (il est listé dans .gitignore).

# Mot de passe du dashboard. Obligatoire si le dashboard est accessible depuis une autre machine.
MNBOT_DASHBOARD_PASSWORD=

# --- Trading réel (laisser vide tant que vous êtes en simulation) ---
# Clé API Kraken : permissions "Query Funds", "Query Open Orders & Trades",
# "Query Closed Orders & Trades", "Create & Modify Orders" UNIQUEMENT.
# NE JAMAIS cocher "Withdraw Funds" (retraits).
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Deuxième verrou du mode réel : doit valoir true ET config/mnbot.json doit contenir "Mode": "Live".
MNBOT_LIVE_TRADING_ENABLED=false

# --- Optionnel ---
# Commentaires de marché rédigés par Claude (lecture seule, aucun accès aux ordres).
ANTHROPIC_API_KEY=
# Alertes sur Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

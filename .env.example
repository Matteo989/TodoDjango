# ─── Base ────────────────────────────────────────────────────────────────────
# En Docker Compose, l'hôte est le nom du service ("postgres" / "redis").
DATABASE_URL="postgresql://iavid:iavid@localhost:5432/iavid?schema=public"
REDIS_URL="redis://localhost:6379"

# Secret de signature des sessions. Générer avec: openssl rand -base64 48
AUTH_SECRET="change-me-openssl-rand-base64-48"

# ─── Stockage ────────────────────────────────────────────────────────────────
# local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Requis pour MinIO / R2.
S3_FORCE_PATH_STYLE="true"

# ─── Fournisseurs IA ─────────────────────────────────────────────────────────
# mock | openai   (mock = aucune clé requise, sortie déterministe, étiquetée dans l'UI)
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# mock | elevenlabs | openai
VOICE_PROVIDER="mock"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
OPENAI_TTS_MODEL="gpt-4o-mini-tts"

# mock  (runway | kling | veo: à implémenter, voir docs/PROVIDERS.md)
VIDEO_PROVIDER="mock"
RUNWAY_API_KEY=""
KLING_API_KEY=""

# manual | youtube  (manual = export du fichier + métadonnées à copier)
PUBLISHING_PROVIDER="manual"

# ─── APIs de publication (OAuth) ─────────────────────────────────────────────
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
META_CLIENT_ID=""
META_CLIENT_SECRET=""

# ─── Binaires ────────────────────────────────────────────────────────────────
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# ─── Divers ──────────────────────────────────────────────────────────────────
# Seuil au-delà duquel un script est signalé comme trop proche d'un existant.
DUPLICATION_THRESHOLD="80"
NEXT_PUBLIC_APP_NAME="IAvid"
